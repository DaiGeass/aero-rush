{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aero Rush",
  "version": "1.0.3",
  "identifier": "com.daigeass.aerorush",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aero Rush",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Carreras 3D estilo Frutiger Aero",
    "longDescription": "Carreras 3D estilo Frutiger Aero con cristal, burbujas, ocho coches, tres modos de juego, dificultad ajustable y ciclo de dia y noche.",
    "copyright": "Copyright (c) 2026 Daigeass y GLP",
    "publisher": "Daigeass y GLP"
  }
}
